# =============================================================================
# PROJECT .GITIGNORE
# =============================================================================
# This file ignores build artifacts, caches, and secrets - NOT project source files
# =============================================================================

# =============================================================================
# PYTHON (Backend)
# =============================================================================
# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Virtual environments
venv/
env/
ENV/
.venv/
.virtualenv/
virtualenv/
pipenv/

# Python distribution / packaging
*.egg-info/
*.egg
dist/
build/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.whl
pip-wheel-metadata/
share/python-wheels/

# Installed packages
site-packages/
.installed.cfg

# pip
pip-log.txt
pip-delete-this-directory.txt

# Testing
.pytest_cache/
htmlcov/
.coverage
*.cover

# Databases
*.db
*.sqlite
*.sqlite3
app.db

# Flutter build outputs
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
.packages
build/
coverage/

# Flutter package downloads
.fvm/
.flutter-sdk/

# Generated files
**/generated_plugin_registrant.dart
**/GeneratedPluginRegistrant.*
**/Flutter/Generated.xcconfig
**/flutter_export_environment.sh

# Flutter ephemeral directories
**/ephemeral/

# Platform-specific
# Android
**/android/**/gradle-wrapper.jar
**/android/.gradle
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/key.properties
*.jks
*.keystore
*.apk
*.aab

# iOS/macOS
**/ios/**/*.framework
**/ios/**/*.xcconfig
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*
**/ios/Flutter/.last_build_id
**/macos/Flutter/GeneratedPluginRegistrant.swift
**/macos/Flutter/ephemeral
**/macos/Flutter/Flutter-Generated.xcconfig
**/macos/Flutter/.last_build_id

# Windows
**/windows/flutter/generated_plugin_registrant.*
**/windows/flutter/generated_plugins.*
**/windows/flutter/.last_build_id

# Linux
**/linux/flutter/generated_plugin_registrant.*
**/linux/flutter/generated_plugins.*
**/linux/flutter/.last_build_id

# Web
**/web/icons/Icon-*
**/web/icons/Icon-maskable-*
**/web/manifest.json

# Exceptions
!**/android/**/src/main/**/GeneratedPluginRegistrant.java
!**/ios/**/GeneratedPluginRegistrant.*
!**/macos/**/GeneratedPluginRegistrant.swift
!**/windows/**/generated_plugin_registrant.*
!**/linux/**/generated_plugin_registrant.*

# =============================================================================
# SECRETS & ENVIRONMENT
# =============================================================================
.env
.env.local
*.key
*.keystore
*.jks
google-services.json

# =============================================================================
# IDE & EDITOR
# =============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
*.iml
.github/

# =============================================================================
# OS
# =============================================================================
.DS_Store
Thumbs.db
Icon
._*
.Trash-*
