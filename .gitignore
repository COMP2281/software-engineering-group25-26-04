# =============================================================================
# PROJECT .GITIGNORE
# =============================================================================
# This file ignores build artifacts, caches, and secrets - NOT project source files
# =============================================================================

# =============================================================================
# PYTHON (Backend)
# =============================================================================
# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Virtual environments
venv/
env/
ENV/
.venv/
.virtualenv/
virtualenv/
pipenv/

# Python distribution / packaging
*.egg-info/
*.egg
dist/
build/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.whl
pip-wheel-metadata/
share/python-wheels/

# Installed packages
site-packages/
.installed.cfg

# pip
pip-log.txt
pip-delete-this-directory.txt

# Testing
.pytest_cache/
htmlcov/
.coverage
*.cover

# Databases
*.db
*.sqlite
*.sqlite3
app.db

# =============================================================================
# FLUTTER/DART (Frontend)
# =============================================================================
# Flutter build outputs
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
.packages
build/
coverage/

# Flutter package downloads
.fvm/
.flutter-sdk/

# Generated files
**/generated_plugin_registrant.dart
**/GeneratedPluginRegistrant.*
**/Flutter/Generated.xcconfig
**/flutter_export_environment.sh

# Flutter ephemeral directories
**/ephemeral/

# =============================================================================
# PLATFORM-SPECIFIC (Android/iOS/Desktop)
# =============================================================================
# Android
.gradle/
gradle-wrapper.jar
gradlew
gradlew.bat
local.properties
*.apk
*.aab

# iOS/macOS
**/Pods/
**/xcuserdata/
**/.symlinks/
**/DerivedData/

# =============================================================================
# SECRETS & ENVIRONMENT
# =============================================================================
.env
.env.local
*.key
*.keystore
*.jks
google-services.json

# =============================================================================
# IDE & EDITOR
# =============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
*.iml

# =============================================================================
# OS
# =============================================================================
.DS_Store
Thumbs.db
Icon
._*
.Trash-*
